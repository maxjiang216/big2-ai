# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# -------------------- Research Experiments --------------------
# Keep source but ignore compiled outputs in research/
research/*.out
research/a.out

# -------------------- Temporary Files --------------------
*.tmp
*.temp
*.bak
*.backup

# -------------------- Analysis Outputs --------------------
# Feature interaction exploration outputs (feature_interaction_explore.py)
analysis/feature_explore_out/
analysis/feature_explore_out_test/

# Tree-greedy HTML reports and CSVs (generate_tree_report.py)
analysis/reports/tree_depth*/

# Generated by bin/generate_data --samples-md (anomaly game write-ups)
analysis/sample_games.md

# Generated plots and figures
*.png
*.pdf
!assets/*.png  # Keep assets folder images
!assets/*.pdf

# Analysis results
*.csv
!*_summary.csv  # Keep summary CSVs for reference

# -------------------- Model Files --------------------
