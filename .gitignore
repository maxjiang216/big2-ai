research/endgame_straight_dp.jsonl
research/endgame_straight_dp_sample.txt
research/tablebase_opp1_samples.txt

# -------------------- Generated Data --------------------
# Training data (too large for git)
*.parquet

# Temporary batch files
tmp_game_batch_*.parquet
tmp_turn_batch_*.parquet

# Logs
*.log
*.txt

# Game records
*.jsonl
game_records.jsonl

# -------------------- Python --------------------
# Virtual environments
venv/
env/
.venv/
*.egg-info/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# -------------------- IDEs and Editors --------------------
# VSCode
.vscode/
*.code-workspace

# CLion / IntelliJ
.idea/
cmake-build-*/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

