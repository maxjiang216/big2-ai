bin/
build/
data/
venv/

# -------------------- Rust --------------------
/target/

# Shared linter configs (make standards_configs → projects/standard-linter)
.code-standards/

# Object files
*.o
*.obj

# Executables (in research folder)
research/a.out
research/avg_moves
research/best_hand
research/big2_moves
research/multi_comb
research/endgame
research/tablebase_opp1
research/tablebase_opp1.bin
